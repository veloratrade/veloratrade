<?php
/**
 * VELORA — ONE-USE POST-DEPLOY DATABASE VERIFICATION probe TEMPLATE.
 *
 * READ-ONLY. It connects through the SAME application connection the app uses
 * (Velora\Core\Database::connection()) and runs a FIXED set of metadata/read checks.
 * It NEVER runs INSERT/UPDATE/DELETE/ALTER/DROP/CREATE, accepts NO SQL/PHP/shell input,
 * and self-deletes after authorized execution. It is NOT a permanent endpoint.
 *
 * Security model mirrors db_backup_probe.php.tmpl:
 *   - token-gated with hash_equals() (timing-safe); random filename; single execution;
 *   - fixed op=verify, fixed explicit env (staging|production);
 *   - emits metadata + pass/fail only; no credentials, DSN, .env, or row payloads beyond
 *     small counts/representative reads;
 *   - the calling workflow treats any non-200 / ok=false as a FAILED deployment.
 */
declare(strict_types=1);

$expected = '__HASH__';
$provided = (string)($_SERVER['HTTP_X_VELORA_MGMT'] ?? '');
if ($provided === '' || !hash_equals($expected, hash('sha256', $provided))) {
    http_response_code(404);
    exit('Not found');
}
@unlink(__FILE__);

require dirname(__DIR__) . '/api/src/bootstrap.php';

use Velora\Core\Database;

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');

$OP  = '__OP__';   // must be 'verify'
$ENV = '__ENV__';  // staging | production

$out = ['probe' => 'velora-db-verify', 'op' => 'verify', 'env' => $ENV, 'time' => gmdate('c')];

if ($OP !== 'verify') {
    http_response_code(400);
    echo json_encode(['ok' => false, 'error' => 'this probe only performs op=verify'],
        JSON_UNESCAPED_SLASHES);
    exit;
}
if ($ENV !== 'staging' && $ENV !== 'production') {
    http_response_code(400);
    echo json_encode(['ok' => false, 'error' => 'unsupported environment'], JSON_UNESCAPED_SLASHES);
    exit;
}

try {
    $pdo = Database::connection();
    $driver = $pdo->getAttribute(PDO::ATTR_DRIVER_NAME);
    $checks = [];
    $fatal  = null;

    if ($driver !== 'mysql') {
        // SQLite/CI fallback: minimal connectivity signal (never used for a prod gate).
        $checks['connectivity'] = ['ok' => true, 'note' => 'non-mysql driver: ' . $driver];
        echo json_encode(['ok' => true, 'env' => $ENV, 'checks' => $checks,
            'warning' => 'non-mysql post-verify'], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
        exit;
    }

    // 1) connectivity + identity (read-only scalars)
    $version = (string)$pdo->query('SELECT VERSION()')->fetchColumn();
    $checks['connectivity'] = ['ok' => true, 'engine_version' => $version];

    // 2) expected critical tables exist
    $critical = ['users', 'trades', 'trading_accounts', 'trade_exits',
                 'ai_jobs', 'ai_feature_flags'];
    $missing = [];
    $tableCounts = [];
    foreach ($critical as $t) {
        $exists = (int)$pdo->query(
            'SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA=DATABASE() '
            . 'AND TABLE_NAME=' . $pdo->quote($t))->fetchColumn();
        if ($exists === 0) { $missing[] = $t; }
        // representative READ count (no row payload emitted)
        try {
            $tableCounts[$t] = (int)$pdo->query('SELECT COUNT(*) FROM `' . $t . '`')->fetchColumn();
        } catch (Throwable $e) {
            $missing[] = $t . '(uncountable)';
            $tableCounts[$t] = -1;
        }
    }
    $checks['critical_tables'] = ['ok' => count($missing) === 0, 'missing' => $missing,
                                  'counts' => $tableCounts];

    // 3) representative critical queries actually run (read-only)
    $rep = [];
    try {
        $rep['trades_total'] = (int)$pdo->query('SELECT COUNT(*) FROM trades')->fetchColumn();
        $rep['users_total']  = (int)$pdo->query('SELECT COUNT(*) FROM users')->fetchColumn();
        $rep['trades_by_symbol'] = $pdo->query(
            'SELECT symbol, COUNT(*) c FROM trades GROUP BY symbol ORDER BY c DESC LIMIT 5')
            ->fetchAll(PDO::FETCH_KEY_PAIR);
        $checks['representative_queries'] = ['ok' => true, 'summary' => $rep];
    } catch (Throwable $e) {
        $checks['representative_queries'] = ['ok' => false, 'error' => $e->getMessage()];
    }

    // 4) basic schema integrity — tables readable, no FK definition errors
    try {
        $baseTables = (int)$pdo->query(
            'SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA=DATABASE() '
            . "AND TABLE_TYPE='BASE TABLE'")->fetchColumn();
        $checks['schema_read'] = ['ok' => $baseTables > 0, 'base_tables' => $baseTables];
    } catch (Throwable $e) {
        $checks['schema_read'] = ['ok' => false, 'error' => $e->getMessage()];
    }

    $allOk = true;
    foreach ($checks as $c) { if (empty($c['ok'])) { $allOk = false; break; } }

    echo json_encode([
        'ok' => $allOk,
        'probe' => 'velora-db-verify',
        'env' => $ENV,
        'verification' => $allOk ? 'POSTDEPLOY_DB_OK' : 'POSTDEPLOY_DB_FAILED',
        'checks' => $checks,
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
} catch (Throwable $e) {
    http_response_code(500);
    echo json_encode([
        'ok' => false, 'env' => $ENV,
        'verification' => 'POSTDEPLOY_DB_FAILED',
        'error' => 'post-deploy DB verification failed: ' . $e->getMessage(),
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
}
