APP_ENV=prod
APP_DEBUG=false
FRONTEND_URL=https://HOST_TEST_URL
CORS_ALLOWED_ORIGINS=https://HOST_TEST_URL

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=velora
DB_DATABASE=velora
DB_USER=velora
DB_PASS=replace-me

MAIL_DRIVER=resend
RESEND_API_KEY=replace-with-resend-api-key
# Resend transport enforces this verified sender in code:
MAIL_FROM=no-reply@veloratrade.ir
MAIL_FROM_NAME=VELORA TRADE

METAAPI_BASE_URL=https://METAAPI_SANDBOX_URL
METAAPI_TOKEN=replace-me
METAAPI_WEBHOOK_SECRET=replace-me

# Used only by the CLI content-translation worker, never by HTTP rendering.
TRANSLATION_SERVICE_NAME=provider-name
TRANSLATION_SERVICE_URL=https://TRANSLATION_SERVICE_URL
TRANSLATION_SERVICE_TOKEN=replace-me

# AI Module (v0.4-v0.6) — $0 budget, Gemini free tier primary, hardened
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=8
# Gemini transport route: direct | n8n_relay (temporary n8n relay while the host region is blocked by Google)
GEMINI_ROUTE=direct
GEMINI_RELAY_URL=
GEMINI_RELAY_TOKEN=
GEMINI_RELAY_TIMEOUT=45
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=10
AI_ENABLED_PROVIDERS=gemini,tesseract
AI_IMAGE_MAX_DIMENSION=1024
AI_IMAGE_JPEG_QUALITY=80
AI_PROMPT_PATH=api/src/AI/Prompts/templates
AI_AUDIT_ENABLED=true
AI_REQUEST_TRACKING_ENABLED=true
AI_FEATURE_FLAGS_ENABLED=true
AI_RETENTION_DAYS=30
