APP_ENV=prod
APP_DEBUG=false
FRONTEND_URL=https://HOST_TEST_URL
CORS_ALLOWED_ORIGINS=https://HOST_TEST_URL

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=velora
DB_DATABASE=velora
DB_USER=velora
DB_PASS=replace-me

MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=replace-me
MAIL_PASS=replace-me
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=VELORA Trade

METAAPI_BASE_URL=https://METAAPI_SANDBOX_URL
METAAPI_TOKEN=replace-me
METAAPI_WEBHOOK_SECRET=replace-me

# Used only by the CLI content-translation worker, never by HTTP rendering.
TRANSLATION_SERVICE_NAME=provider-name
TRANSLATION_SERVICE_URL=https://TRANSLATION_SERVICE_URL
TRANSLATION_SERVICE_TOKEN=replace-me
